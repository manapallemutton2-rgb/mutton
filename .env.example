# Copy to .env and fill from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_or_anon_jwt
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_or_service_role_jwt

# Required Supabase setup (run once):
# 1. supabase db push  (applies supabase/migrations 001-010)
# 2. Storage bucket `product-images` is auto-created by migration 010; set it Public
#    if you want <img src="...product-images..."> to load without signed URLs.
